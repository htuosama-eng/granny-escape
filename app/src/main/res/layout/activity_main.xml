<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <com.osama.escapehouse.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFC107"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnHide"
            android:layout_width="110dp"
            android:layout_height="56dp"
            android:text="@string/hide" />
        <Button
            android:id="@+id/btnPause"
            android:layout_width="110dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/pause" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FF5252"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Start menu -->
    <LinearLayout
        android:id="@+id/menuStart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#E6000000">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="#FF5252"
            android:textSize="42sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/tvBest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFC107"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <Button android:id="@+id/btnEasy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/easy" />
            <Button android:id="@+id/btnNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/normal" android:layout_marginStart="8dp" />
            <Button android:id="@+id/btnHard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hard" android:layout_marginStart="8dp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnStart"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/start" />
        <Button
            android:id="@+id/btnHow"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/how" />
        <TextView
            android:id="@+id/tvHow"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="@string/how_text"
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- End screen -->
    <LinearLayout
        android:id="@+id/menuEnd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#E6000000"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvEndTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvEndText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFC107"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/btnRestart"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/restart" />
        <Button
            android:id="@+id/btnMenu"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/menu" />
    </LinearLayout>

</FrameLayout>
